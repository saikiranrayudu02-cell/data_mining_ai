# Production (Vercel): set this in the Vercel Dashboard under Project Settings → Environment Variables
# This value is read by next.config.ts at BUILD TIME to configure the rewrite proxy destination.
#
# REQUIRED: Add this in Vercel Dashboard → Settings → Environment Variables
# Key:   NEXT_PUBLIC_API_URL
# Value: https://data-mining-ai-backend.onrender.com
#
NEXT_PUBLIC_API_URL=https://data-mining-ai-backend.onrender.com
