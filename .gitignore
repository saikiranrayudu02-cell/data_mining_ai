# Dependency directories
node_modules/
backend/venv/
.venv/
env/
ENV/

# Build outputs
.next/
out/
dist/
build/
*.egg-info/

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# IDE files
.vscode/
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Application uploads and models storage
# Ignore all files in storage but keep the folders
backend/app/storage/uploads/*
!backend/app/storage/uploads/.gitkeep
backend/app/storage/models/*
!backend/app/storage/models/.gitkeep
backend/app/storage/plots/*
!backend/app/storage/plots/.gitkeep
backend/app/storage/exports/*
!backend/app/storage/exports/.gitkeep

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
